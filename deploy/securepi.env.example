# SecurePi (FlowGuard) systemd environment file — EXAMPLE.
#
# Copy to /etc/securepi/securepi.env and edit. KEY=VALUE per line, no shell quoting.
# This example contains PLACEHOLDERS ONLY — never commit real values. The one
# secret here is EDGE_INGEST_TOKEN (the FlowGuard edge-ingest bearer token); keep
# the real /etc/securepi/securepi.env root-owned and mode 0600, and note that the
# repo .gitignore already excludes *.env so a filled-in copy is never committed.
#
#   sudo mkdir -p /etc/securepi
#   sudo cp deploy/securepi.env.example /etc/securepi/securepi.env
#   sudo nano /etc/securepi/securepi.env
#   sudo chmod 600 /etc/securepi/securepi.env

# Absolute path to the checked-out repository on the Pi (no trailing slash).
SECUREPI_INSTALL_DIR=/home/CHANGE_ME/SecurePi_FlowGuard

# Preset file name inside edge/presets/ (e.g. lobby.args, kitchen.args, carpark.args).
# This example is for the KITCHEN node (pest/rat detection) — keep PRESET,
# DEVICE_ID and CAMERA_LOCATION below in sync with the SAME zone; a mismatch
# here (e.g. this preset but a different camera's device id/location) makes
# SecurePi report a zone_name/device identity that doesn't match this node's
# real camera to the FlowGuard backend.
SECUREPI_PRESET=kitchen.args

# Compiled IMX500 network. For the CUSTOM FlowGuard model use the path below.
# For the stock COCO model instead, point this at
# /usr/share/imx500-models/imx500_network_ssd_mobilenetv2_fpnlite_320x320_pp.rpk
# and clear SECUREPI_LABELS (the stock model has built-in labels).
SECUREPI_MODEL=/home/CHANGE_ME/SecurePi_FlowGuard/models/imx500_custom_securepi.rpk

# Labels file matching the model's output order (only needed for the custom model).
SECUREPI_LABELS=/home/CHANGE_ME/SecurePi_FlowGuard/models/labels.txt

# Where runtime output (snapshots/, logs/, alerts/) is written. Choose a path
# the run-user can write to and that survives reboots.
SECUREPI_RUNTIME_DIR=/var/lib/securepi/runtime

# Optional extra flags appended verbatim (word-split). Leave empty if unused.
# Example: SECUREPI_EXTRA_ARGS=--unattended-time 90 --pest-confidence 0.6
SECUREPI_EXTRA_ARGS=

# ---------------------------------------------------------------------------
# FlowGuard cloud integration (edge -> FlowGuard backend edge-ingest endpoint)
# ---------------------------------------------------------------------------
# SecurePi POSTs authenticated detection events to FlowGuard, which owns DB
# persistence, WhatsApp credentials and message formatting. The Pi NEVER calls
# WhatsApp directly. When disabled (default), SecurePi runs fully offline: local
# snapshots + events.csv still work and NO outbox files are created.
#
# Master switch. Leave false to run offline (no network calls, no outbox).
FLOWGUARD_EDGE_ENABLED=false
# Base URL of the FlowGuard backend (NO trailing path; the client appends
# /api/edge/detection-alerts).
FLOWGUARD_API_URL=https://your-flowguard-server.example
# Edge-ingest bearer token — must equal the backend's EDGE_INGEST_TOKEN.
# PLACEHOLDER — replace in the real, permission-restricted env file only.
EDGE_INGEST_TOKEN=replace-me
# Stable identity for this device (used in the deterministic event_id).
# Matches the "Kitchen" zone this node's camera covers — see SECUREPI_PRESET above.
SECUREPI_DEVICE_ID=securepi-kitchen-01
# Human camera label shown in the FlowGuard dashboard / WhatsApp alert.
SECUREPI_CAMERA_LOCATION=Kitchen Camera 01
# HTTP request timeout (seconds) — keep short so a slow cloud never stalls flush.
SECUREPI_HTTP_TIMEOUT_SEC=5
# How often the outbox retries queued events while running (seconds).
SECUREPI_RETRY_INTERVAL_SEC=30
# Disk-backed outbox directory (crash-safe queue). Keep it under the runtime dir
# so it is git-ignored and writable by the run-user.
SECUREPI_OUTBOX_DIR=/var/lib/securepi/runtime/alerts/outbox

# ---------------------------------------------------------------------------
# PIR + ultrasonic sensor bridge (edge/sensor_bridge.py) — OPTIONAL, separate
# process (securepi-sensor-bridge.service). Owns ONLY the serial port, never the
# camera, and reuses FLOWGUARD_API_URL / EDGE_INGEST_TOKEN above. It raises a
# RESTRICTED_MOTION event on a motion transition during restricted hours only.
# ---------------------------------------------------------------------------
# Master switch for the sensor-bridge service (off by default).
SENSOR_BRIDGE_ENABLED=false
# Arduino serial device. Common Pi paths: /dev/ttyACM0 (Uno R3) or /dev/ttyUSB0.
SENSOR_SERIAL_PORT=/dev/ttyACM0
SENSOR_BAUD_RATE=9600
# Restricted zone identity (shown in the FlowGuard dashboard / WhatsApp alert).
RESTRICTED_ZONE_NAME=Chemical Storage
RESTRICTED_CAMERA_LOCATION=Chemical Storage Camera 01
# After-hours window in Singapore time (HH:MM). Supports an overnight range.
RESTRICTED_HOURS_START=08:00
RESTRICTED_HOURS_END=23:00
# Minimum seconds between restricted-motion alerts.
MOTION_ALERT_COOLDOWN_SEC=60
